# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is in .gitignore.
# NEVER put real keys or passwords in this file.

# --- Database ---
# Production: use a strong random password (min 20 chars)
DATABASE_URL=postgresql://fitness:CHANGE_ME_STRONG_PASSWORD@db:5432/fitness_challenge

# --- Groq AI ---
# Get a free key from https://console.groq.com
# NEVER put a real key here — this file IS committed to git
GROQ_API_KEY=gsk_your_key_here

# --- CORS ---
# Comma-separated list of allowed origins (no trailing slash)
# Production: https://yourapp.com
FRONTEND_URL=http://localhost:5173

# --- Security ---
# REQUIRED: Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# A missing or placeholder SECRET_KEY will crash the app in production.
SECRET_KEY=change_me_generate_a_real_secret_key

# --- Token settings ---
ACCESS_TOKEN_EXPIRE_MINUTES=30       # 30 min recommended (max 60)
LOGIN_MAX_FAILURES=5                 # Lock account after N failures
LOGIN_LOCKOUT_SECONDS=900            # 15-minute lockout window

# --- Environment ---
ENVIRONMENT=development   # development | production
